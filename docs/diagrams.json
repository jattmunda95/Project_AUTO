          "New Item + ADDED"
        ],
        "accent": false
      },
      {
        "id": "return",
        "box": [
          300,
          270,
          250,
          70
        ],
        "lines": [
          "Match to removed item",
          "Same Item + RETURNED"
        ],
        "accent": false
      },
